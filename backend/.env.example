# Plantilla de variables de entorno del backend.
# Copia este archivo como .env y completa los valores reales:
#   cp .env.example .env
# El .env NUNCA se sube al repositorio (esta en .gitignore).

# Cadena de conexion a PostgreSQL que usa Prisma.
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DE_DATOS?schema=public
DATABASE_URL=

# Clave secreta para firmar los tokens JWT del login.
# Usa una cadena larga y aleatoria, distinta en cada entorno.
JWT_SECRET=

# Puerto donde escucha la API. Si se omite, usa 3000.
PORT=
