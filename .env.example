# Variables para levantar el proyecto con Docker Compose.
# Copia este archivo como .env en la raíz del repo (el .env real NO se sube a git):
#   cp .env.example .env            (Linux / Mac / Git Bash)
#   Copy-Item .env.example .env     (PowerShell)
# Docker Compose lee el .env de la raíz automáticamente.

# Clave secreta para firmar los tokens JWT del login.
# Para una prueba local sirve este valor; en un entorno real usa una cadena larga y aleatoria.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Estas ya están definidas dentro de docker-compose.yml para el entorno local.
# Se documentan aquí como referencia:
# DATABASE_URL=postgresql://appuser:apppass@postgres:5432/appdb
# PORT=4000
